Encoding: UTF-8
Language: en-US
URL: https://averrik.github.io/dbAudit/docs/
Depends:
    R (>= 4.1.0)
Imports:
    data.table,
    jsonlite,
    lubridate,
    readxl,
    stringr,
    utils
Suggests:
    testthat (>= 3.0.0)
Config/testthat/edition: 3
NeedsCompilation: no

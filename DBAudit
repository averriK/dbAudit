showHelp <- function() {
  defaults <- NULL
  if (exists(".dbauditPathDefaults", mode = "any")) {
    defaults <- get(".dbauditPathDefaults", mode = "any")
  }

  lab.def <- if (is.list(defaults) && !is.null(defaults$lab.dir.name) && nzchar(defaults$lab.dir.name)) {
    defaults$lab.dir.name
  } else {
    "raw/lab"
  }

  assay.def <- if (is.list(defaults) && !is.null(defaults$assay.dir.name) && nzchar(defaults$assay.dir.name)) {
    defaults$assay.dir.name
  } else {
    "raw/assay"
  }

  proc.def <- if (is.list(defaults) && !is.null(defaults$proc.dir.name) && nzchar(defaults$proc.dir.name)) {
    defaults$proc.dir.name
  } else {
    "proc"
  }

  docs.url <- if (exists(".dbauditDocsUrl", mode = "any")) {
    get(".dbauditDocsUrl", mode = "any")
  } else {
    "https://averrik.github.io/dbAudit/docs/"
  }

  cat("dbaudit\n\n")
  cat("USAGE:\n")
  cat("  dbaudit [geochemistry|piezometer|inclinometer] --project <DATA_ROOT> [OPTIONS]\n\n")
  cat("REQUIRED:\n")
  cat("  --project <DATA_ROOT>\n\n")
  cat("GEOCHEMISTRY OPTIONS (default contract):\n")
  cat(sprintf("  --lab-dir      <REL_PATH>           (default: %s)\n", lab.def))
  cat(sprintf("  --assay-dir    <REL_PATH>           (default: %s)\n", assay.def))
  cat(sprintf("  --proc-dir     <REL_PATH>           (default: %s)\n", proc.def))
  cat("  --assay-file   <PATH>               (optional override; absolute path OR basename under assay-dir)\n")
  cat("  --lab-format   <auto|A|B>           (default: auto)\n")
  cat("  --assay-format <auto|A|B>           (default: auto)\n")
  cat("  --tol          <NUMBER>             (default: 0.05; relative tolerance for value audits)\n")
  cat("\n")
  cat("PIEZOMETER OPTIONS:\n")
  cat("  --id           <ID[,ID]>            (default: PCG,PCV)\n")
  cat("  --manifest     <PATH>               (default: inst/extdata/piezometer-manifest.json)\n")
  cat("  --source-dir   <REL_PATH>           (default: source)\n")
  cat("  --raw-dir      <REL_PATH>           (default: raw)\n")
  cat("  --db-dir       <REL_PATH>           (default: db)\n")
  cat("  --audit-dir    <REL_PATH>           (default: audit)\n")
  cat("\n")
  cat("INCLINOMETER OPTIONS:\n")
  cat("  --manifest     <PATH>               (optional override of the parse manifest)\n")
  cat("  --source-dir   <REL_PATH>           (default: source)\n")
  cat("  --raw-dir      <REL_PATH>           (default: raw)\n")
  cat("  --db-dir       <REL_PATH>           (default: db)\n")
  cat("  --audit-dir    <REL_PATH>           (default: audit)\n")
  cat("\n")
  cat("GENERAL:\n")
  cat("  --check                             (verify installation and dependencies)\n")
  cat("  --version\n")
  cat("  --help, -h\n")
  cat("\n")
  cat("DOCS:\n")
  cat("  In-repo: docs/ (see docs/quickstart.md, docs/project-layout.md, docs/audit.md, docs/logging.md)\n")
  cat(sprintf("  Pages : %s\n", docs.url))
  cat("\n")
}

showVersion <- function() {
  cat("dbaudit\n")

  root <- tryCatch(.dbauditRoot(), error = function(e) NULL)
  if (is.null(root)) {
    cat("Build: unknown (installation not detected)\n")
    return(invisible(NULL))
  }

  version.file <- file.path(root, ".version")
  if (!file.exists(version.file)) {
    cat("Build: unknown (version file not found)\n")
    return(invisible(NULL))
  }

  lines <- tryCatch(readLines(version.file, warn = FALSE), error = function(e) NULL)
  if (is.null(lines) || length(lines) == 0) {
    cat("Build: unknown (could not read version file)\n")
    return(invisible(NULL))
  }

  # Tolerate a BOM from older Windows installers: it prefixes the first
  # key and hides every field from the key=value parser.
  lines[1] <- sub("^\ufeff", "", lines[1])

  info <- list()
  for (line in lines) {
    parts <- strsplit(line, "=", fixed = TRUE)[[1]]
    if (length(parts) == 2) {
      info[[parts[1]]] <- parts[2]
    }
  }

  commit <- if (!is.null(info$commit) && nzchar(info$commit)) info$commit else "unknown"
  branch <- if (!is.null(info$branch) && nzchar(info$branch)) info$branch else "unknown"
  tag <- if (!is.null(info$tag) && nzchar(info$tag)) info$tag else ""
  install_date <- if (!is.null(info$install_date) && nzchar(info$install_date)) info$install_date else "unknown"

  if (nzchar(tag)) {
    cat(sprintf("Build: %s (%s) [%s]\n", commit, branch, tag))
  } else {
    cat(sprintf("Build: %s (%s)\n", commit, branch))
  }
  cat(sprintf("Installed: %s\n", install_date))

  invisible(NULL)
}

showSystemInfo <- function() {
  cat("dbaudit System Diagnostics\n")
  cat(rep("=", 50), "\n\n", sep = "")

  # R version
  r_version <- paste(R.version$major, R.version$minor, sep = ".")
  cat(sprintf("R version: %s\n", r_version))

  # Rscript location + execution check
  rscript_path <- Sys.which("Rscript")
  rscript_current <- file.path(
    R.home("bin"),
    if (.Platform$OS.type == "windows") "Rscript.exe" else "Rscript"
  )

  if (nzchar(rscript_path)) {
    cat(sprintf("Rscript (PATH): %s\n", rscript_path))
  } else {
    cat("Rscript (PATH): NOT FOUND\n")
  }

  if (file.exists(rscript_current)) {
    cat(sprintf("Rscript (current): %s\n", rscript_current))
  } else {
    cat("Rscript (current): NOT FOUND\n")
  }

  rscript_check <- if (nzchar(rscript_path)) rscript_path else rscript_current
  if (nzchar(rscript_check) && file.exists(rscript_check)) {
    out <- tryCatch(
      system2(rscript_check, "--version", stdout = TRUE, stderr = TRUE),
      error = function(e) NULL
    )
    status <- if (is.null(out)) 1 else attr(out, "status")
    if (is.null(status)) {
      cat("Rscript run: OK\n")
    } else {
      cat(sprintf("Rscript run: FAILED (exit %s)\n", status))
    }
  } else {
    cat("Rscript run: FAILED (not found)\n")
  }

  # Installation root
  root <- tryCatch(.dbauditRoot(), error = function(e) NULL)
  if (!is.null(root)) {
    cat(sprintf("Installation: %s\n", root))
  } else {
    cat("Installation: NOT DETECTED\n")
  }

  cat("\n")

  # Package status
  required_pkgs <- c("data.table", "stringr", "lubridate", "readxl", "jsonlite")
  cat("Required R Packages:\n")

  all_ok <- TRUE
  for (pkg in required_pkgs) {
    is_installed <- requireNamespace(pkg, quietly = TRUE)
    status_icon <- if (is_installed) "\u2713" else "\u2717"

    if (is_installed) {
      pkg_version <- tryCatch(
        as.character(packageVersion(pkg)),
        error = function(e) "unknown"
      )
      cat(sprintf("  [%s] %s (version %s)\n", status_icon, pkg, pkg_version))
    } else {
      cat(sprintf("  [%s] %s - MISSING\n", status_icon, pkg))
      all_ok <- FALSE
    }
  }

  cat("\n")

  if (all_ok) {
    cat("Status: \u2713 All dependencies satisfied\n")
  } else {
    cat("Status: \u2717 Missing dependencies - run dbaudit to auto-install\n")
  }

  invisible(NULL)
}

.getScriptFile <- function() {
  args <- commandArgs(trailingOnly = FALSE)
  hit <- grep("^--file=", args, value = TRUE)
  if (!length(hit)) return(NA_character_)
  sub("^--file=", "", hit[1])
}

# Locate installation/repo root:
# - Prefer DBAUDIT_HOME when present (set by the bash wrapper)
# - Otherwise infer from this script's own path
.dbauditRoot <- function() {
  env <- Sys.getenv("DBAUDIT_HOME")
  if (nzchar(env) && file.exists(file.path(env, "R", "setup.R"))) {
    return(normalizePath(env, mustWork = TRUE))
  }

  f <- .getScriptFile()
  if (is.na(f) || !nzchar(f)) {
    stop("Cannot locate DBAudit script path (--file=... missing). Run via 'dbaudit' or 'Rscript /path/to/DBAudit'.")
  }
  normalizePath(dirname(f), mustWork = TRUE)
}

root <- .dbauditRoot()

args <- commandArgs(trailingOnly = TRUE)

# Contract dispatch: a leading non-flag token selects the pipeline contract.
# A leading '-' (or no arguments) keeps the legacy geochemical invocation
# unchanged, so existing callers are unaffected.
slug <- ""
if (length(args) > 0L && !startsWith(args[1L], "-")) {
  slug <- args[1L]
  args <- args[-1L]
  if (!(slug %in% c("geochemistry", "piezometer", "inclinometer"))) {
    stop(sprintf(
      "Unknown command: %s (expected: geochemistry, piezometer, inclinometer)",
      slug
    ))
  }
}

# Early exits (avoid loading packages / triggering auto-installs just to print help/version/check)
if (length(args) == 0L || any(args %in% c("-h", "--help"))) {
  # Source the runner to load canonical defaults for help output.
  dbAudit.file <- file.path(root, "R", "dbAudit.R")
  if (file.exists(dbAudit.file)) source(dbAudit.file)

  showHelp()
  quit(save = "no", status = 0)
}

if (any(args %in% c("--version"))) {
  showVersion()
  quit(save = "no", status = 0)
}

if (any(args %in% c("--check", "--system-info"))) {
  showSystemInfo()
  quit(save = "no", status = 0)
}

# Full runtime (may auto-install R packages via R/setup.R)
setup.file <- file.path(root, "R", "setup.R")
if (!file.exists(setup.file)) {
  stop(sprintf("Invalid installation: missing %s", setup.file))
}

source(setup.file)
if (exists(".dbauditLoadRuntime", mode = "function")) {
  .dbauditLoadRuntime()
}
source(file.path(root, "R", "helpers.R"))
source(file.path(root, "R", "eventLog.R"))
source(file.path(root, "R", "parseLab.R"))
source(file.path(root, "R", "parseAssay.R"))
source(file.path(root, "R", "audit.R"))
source(file.path(root, "R", "dbAudit.R"))
source(file.path(root, "R", "piezometerParse.R"))
source(file.path(root, "R", "piezometerBuild.R"))
source(file.path(root, "R", "piezometerAudit.R"))
source(file.path(root, "R", "auditPiezometer.R"))
source(file.path(root, "R", "inclinometerParse.R"))
source(file.path(root, "R", "inclinometerBuild.R"))
source(file.path(root, "R", "inclinometerAudit.R"))
source(file.path(root, "R", "auditInclinometer.R"))

# ----------------------------------------------------------------------
# Piezometer contract: own argument loop, then the full runner.

if (identical(slug, "piezometer")) {
  for (pkg in c("readxl", "jsonlite")) {
    if (!requireNamespace(pkg, quietly = TRUE)) {
      stop(sprintf("The piezometer contract requires the '%s' package.", pkg))
    }
  }

  project.path <- ""
  id <- "PCG,PCV"
  manifest <- ""
  dirs <- list()

  k <- 1L
  while (k <= length(args)) {
    a <- args[k]
    if (identical(a, "--project")) {
      if (k == length(args)) stop("--project requires a value")
      if (nzchar(project.path)) stop("--project specified more than once")
      project.path <- args[k + 1L]
      k <- k + 2L
      next
    }
    if (identical(a, "--id")) {
      if (k == length(args)) stop("--id requires a value")
      id <- args[k + 1L]
      k <- k + 2L
      next
    }
    if (identical(a, "--manifest")) {
      if (k == length(args)) stop("--manifest requires a value")
      manifest <- args[k + 1L]
      k <- k + 2L
      next
    }
    if (a %in% c("--source-dir", "--raw-dir", "--db-dir", "--audit-dir")) {
      if (k == length(args)) stop(sprintf("%s requires a value", a))
      Name <- c(
        "--source-dir" = "source.dir.name", "--raw-dir" = "raw.dir.name",
        "--db-dir" = "db.dir.name", "--audit-dir" = "audit.dir.name"
      )[[a]]
      dirs[[Name]] <- args[k + 1L]
      k <- k + 2L
      next
    }
    stop(sprintf("Unknown argument: %s", a))
  }

  if (!nzchar(project.path)) {
    stop("Missing --project. Try: dbaudit piezometer --project <DATA_ROOT>")
  }

  manifest.file <- file.path(root, "inst", "extdata", "piezometer-manifest.json")
  if (nzchar(manifest)) manifest.file <- manifest

  do.call(auditPiezometer, c(list(
    project.path = project.path,
    id = strsplit(id, ",", fixed = TRUE)[[1L]],
    manifest = manifest.file
  ), dirs))
  quit(save = "no", status = 0)
}

if (identical(slug, "inclinometer")) {
  for (pkg in c("jsonlite")) {
    if (!requireNamespace(pkg, quietly = TRUE)) {
      stop(sprintf("The inclinometer contract requires the '%s' package.", pkg))
    }
  }

  project.path <- ""
  manifest <- ""
  dirs <- list()

  k <- 1L
  while (k <= length(args)) {
    a <- args[k]
    if (identical(a, "--project")) {
      if (k == length(args)) stop("--project requires a value")
      if (nzchar(project.path)) stop("--project specified more than once")
      project.path <- args[k + 1L]
      k <- k + 2L
      next
    }
    if (identical(a, "--manifest")) {
      if (k == length(args)) stop("--manifest requires a value")
      manifest <- args[k + 1L]
      k <- k + 2L
      next
    }
    if (a %in% c("--source-dir", "--raw-dir", "--db-dir", "--audit-dir")) {
      if (k == length(args)) stop(sprintf("%s requires a value", a))
      Name <- c(
        "--source-dir" = "source.dir.name", "--raw-dir" = "raw.dir.name",
        "--db-dir" = "db.dir.name", "--audit-dir" = "audit.dir.name"
      )[[a]]
      dirs[[Name]] <- args[k + 1L]
      k <- k + 2L
      next
    }
    stop(sprintf("Unknown argument: %s", a))
  }

  if (!nzchar(project.path)) {
    stop("Missing --project. Try: dbaudit inclinometer --project <DATA_ROOT>")
  }

  # The runtime is not the installed R package: resolve the manifest from
  # the installation root, as the piezometer path already does. Asking
  # the package for it returns "" wherever dbAudit was installed as the
  # command line only, which is the documented way to install it.
  manifest.file <- file.path(root, "inst", "extdata", "piezometer-manifest.json")
  if (nzchar(manifest)) manifest.file <- manifest

  do.call(auditInclinometer, c(list(
    project.path = project.path,
    manifest = manifest.file
  ), dirs))
  quit(save = "no", status = 0)
}

# Canonical path defaults (single source of truth)
defaults <- if (exists(".dbauditPathDefaults", mode = "any")) {
  get(".dbauditPathDefaults", mode = "any")
} else {
  list(lab.dir.name = "raw/lab", assay.dir.name = "raw/assay", proc.dir.name = "proc")
}

project.path <- ""
lab.dir.name <- defaults$lab.dir.name
assay.dir.name <- defaults$assay.dir.name
proc.dir.name <- defaults$proc.dir.name
assay.file <- ""
lab.format <- "auto"
assay.format <- "auto"
tol <- 5e-2

k <- 1L
while (k <= length(args)) {
  a <- args[k]

  if (identical(a, "--project")) {
    if (k == length(args)) stop("--project requires a value")
    if (nzchar(project.path)) stop("--project specified more than once")
    project.path <- args[k + 1L]
    k <- k + 2L
    next
  }

  if (identical(a, "--lab-dir")) {
    if (k == length(args)) stop("--lab-dir requires a value")
    lab.dir.name <- args[k + 1L]
    k <- k + 2L
    next
  }

  if (identical(a, "--assay-dir")) {
    if (k == length(args)) stop("--assay-dir requires a value")
    assay.dir.name <- args[k + 1L]
    k <- k + 2L
    next
  }

  if (identical(a, "--proc-dir")) {
    if (k == length(args)) stop("--proc-dir requires a value")
    proc.dir.name <- args[k + 1L]
    k <- k + 2L
    next
  }

  if (identical(a, "--assay-file")) {
    if (k == length(args)) stop("--assay-file requires a value")
    if (nzchar(assay.file)) stop("--assay-file specified more than once")
    assay.file <- args[k + 1L]
    k <- k + 2L
    next
  }

  if (identical(a, "--lab-format")) {
    if (k == length(args)) stop("--lab-format requires a value")
    lab.format <- args[k + 1L]
    k <- k + 2L
    next
  }

  if (identical(a, "--assay-format")) {
    if (k == length(args)) stop("--assay-format requires a value")
    assay.format <- args[k + 1L]
    k <- k + 2L
    next
  }

  if (identical(a, "--tol")) {
    if (k == length(args)) stop("--tol requires a value")
    tol <- suppressWarnings(as.numeric(args[k + 1L]))
    if (is.na(tol) || !is.finite(tol) || tol < 0) {
      stop(sprintf("Invalid --tol: %s (expected a non-negative number)", args[k + 1L]))
    }
    k <- k + 2L
    next
  }

  stop(sprintf("Unknown argument: %s", a))
}

if (!nzchar(project.path)) {
  stop("Missing --project. Try: dbaudit --project project/<PROJECT>/data")
}

assay.file.arg <- NULL
if (nzchar(assay.file)) assay.file.arg <- assay.file

lab.format <- toupper(lab.format)
assay.format <- toupper(assay.format)

if (!(lab.format %in% c("AUTO", "A", "B"))) {
  stop(sprintf("Invalid --lab-format: %s (expected auto|A|B)", lab.format))
}
if (!(assay.format %in% c("AUTO", "A", "B"))) {
  stop(sprintf("Invalid --assay-format: %s (expected auto|A|B)", assay.format))
}

# Normalize to canonical tokens used by parseLabData()/parseAssayData()
if (lab.format == "AUTO") lab.format <- "auto"
if (assay.format == "AUTO") assay.format <- "auto"

DBAudit(
  project.path = project.path,
  lab.dir.name = lab.dir.name,
  assay.dir.name = assay.dir.name,
  proc.dir.name = proc.dir.name,
  assay.file = assay.file.arg,
  lab.format = lab.format,
  assay.format = assay.format,
  tol = tol
)
